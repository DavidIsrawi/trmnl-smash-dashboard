STARTGG_TOKEN=your_token_here
TRMNL_WEBHOOK_URL=your_webhook_url
REFRESH_INTERVAL_MINUTES=60
PORT=8080

# IANA timezone used to format dates and compute "days remaining".
# Azure App Service runs in UTC, so set this to your local zone.
TIMEZONE=America/Los_Angeles

# Set to "true" to log the full payload JSON each refresh cycle.
DEBUG_PAYLOAD=false
