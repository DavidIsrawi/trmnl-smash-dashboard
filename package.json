{
  "name": "trmnl-smash-plugin",
  "version": "1.0.0",
  "description": "TRMNL Plugin for Super Smash Bros. Ultimate Tournament Data",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && npm run copy:assets",
    "copy:assets": "rm -rf dist/data && mkdir -p dist && cp -R src/data dist/data",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "preview": "tsx src/preview.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write .",
    "test": "echo 'Error: no test specified' && exit 0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "graphql": "^16.8.1",
    "graphql-request": "^7.4.0",
    "liquidjs": "^10.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.8.1",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0"
  }
}
